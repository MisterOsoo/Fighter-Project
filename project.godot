window/size/viewport_height=480
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/activeFrameHitbox/plugin.cfg", "res://addons/collision_presets/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

